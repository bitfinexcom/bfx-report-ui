{
  "name": "bfx-report-ui",
  "version": "2.64.0",
  "description": "Report page to overview the user actions in Bitfinex and download related csv files",
  "repository": {
    "type": "git",
    "url": "https://github.com/bitfinexcom/bfx-report-ui.git"
  },
  "keywords": [
    "bitfinex"
  ],
  "author": "Bitfinex",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/bitfinexcom/bfx-report-ui/issues"
  },
  "homepage": "/",
  "dependencies": {
    "@bitfinex/lib-js-util-base": "git+https://github.com/bitfinexcom/lib-js-util-base.git#8ac3d64c460f9468dc885f87a33251fd9f1e640f",
    "@blueprintjs/core": "3.54.0",
    "@blueprintjs/datetime": "3.24.1",
    "@blueprintjs/icons": "3.33.0",
    "@blueprintjs/select": "3.19.1",
    "@blueprintjs/table": "3.5.0",
    "@blueprintjs/timezone": "3.10.1",
    "@hcaptcha/react-hcaptcha": "2.0.2",
    "axios": "1.18.1",
    "bignumber.js": "9.3.1",
    "classnames": "2.5.1",
    "flexboxgrid2": "7.2.1",
    "history": "4.10.1",
    "i18next": "15.0.7",
    "i18next-browser-languagedetector": "3.0.1",
    "i18next-http-backend": "4.0.0",
    "js-cookie": "3.0.8",
    "lightweight-charts": "1.2.2",
    "lodash": "4.18.1",
    "memoize-one": "5.2.1",
    "moment": "2.29.4",
    "moment-timezone": "0.5.35",
    "normalize.css": "8.0.1",
    "prop-types": "15.8.1",
    "query-string": "9.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-google-recaptcha": "3.1.0",
    "react-i18next": "10.5.2",
    "react-redux": "7.2.8",
    "react-router-dom": "5.3.4",
    "react-swipeable": "5.5.1",
    "react-transition-group": "2.9.0",
    "recharts": "2.1.13",
    "redux": "4.2.0",
    "redux-first-history": "5.2.0",
    "redux-logger": "3.0.6",
    "redux-persist": "6.0.0",
    "redux-saga": "1.4.2",
    "sass": "1.50.0",
    "shelljs": "0.10.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "7.21.11",
    "@redux-saga/testing-utils": "1.2.3",
    "babel-eslint": "10.1.0",
    "concurrently": "5.3.0",
    "cross-env": "7.0.3",
    "eslint": "7.32.0",
    "eslint-config-airbnb": "17.1.0",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.32.2",
    "husky": "9.1.7",
    "jest-junit": "17.0.0",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "prepare": "node scripts/copyFiles && node scripts/handleBptIcons && husky",
    "start": "cross-env REACT_APP_ENV=development FAST_REFRESH=false ESLINT_NO_DEV_ERRORS=true react-scripts start",
    "startAll": "concurrently \"npm run start\" \"npm run --prefix ../bfx-reports-framework startSimulEnv\" \"npm run --prefix ../bfx-reports-framework startServDev\" \"npm run --prefix ../bfx-reports-framework startDev\"",
    "startAllWeb": "concurrently \"npm run start\" \"npm run --prefix ../bfx-report startSimulEnv\" \"npm run --prefix ../bfx-report startServDev\" \"npm run --prefix ../bfx-report startDev\"",
    "build": "npm run prepare && npm run lint && cross-env REACT_APP_ENV=$CI_ENVIRONMENT_NAME react-scripts build",
    "test": "npm run lint && cross-env REACT_APP_ENV=testing react-scripts test --env=jsdom --modulePaths=src --verbose --color --watchAll=false",
    "lint": "eslint src scripts --ignore-path .gitignore",
    "lintFix": "eslint src scripts --fix --ignore-path .gitignore"
  },
  "engines": {
    "node": ">=18.17.1",
    "npm": ">=9.6.7"
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(query-string|decode-uri-component|split-on-first|filter-obj)/)"
    ]
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "overrides": {
    "bfj": "9.1.3",
    "serialize-javascript": "7.0.5",
    "html-parse-stringify2": "2.0.2"
  }
}
